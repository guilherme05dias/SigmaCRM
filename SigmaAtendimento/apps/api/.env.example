DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

PORT=3334
JWT_SECRET=troque-por-uma-string-longa-e-aleatoria

# CORS — URL do frontend no Vercel (sem barra no final)
CORS_ORIGIN=https://seu-app.vercel.app

# WhatsApp provider: meta-cloud | murilo-api | mock
WHATSAPP_PROVIDER=meta-cloud

# Meta Cloud API
META_WHATSAPP_API_BASE_URL=https://graph.facebook.com/v20.0
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_VERIFY_TOKEN=sigma_verify_token_123
META_APP_SECRET=
# ENCRYPTION_KEY: 64 hex chars. Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# murilo-api (WhatsApp Web) — usado se WHATSAPP_PROVIDER=murilo-api
MURILO_WHATSAPP_API_BASE_URL=http://localhost:3000
MURILO_WHATSAPP_DEFAULT_SESSION_ID=default

# Token interno para chamadas service-to-service
SIGMA_INTERNAL_TOKEN=gere-um-token-aleatorio-aqui
