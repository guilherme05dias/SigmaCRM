# Sigma Atendimento - exemplo de ambiente
# Copie para .env no ambiente local/servidor e preencha sem commitar segredos reais.

# API
PORT=3334
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
CORS_ORIGIN=http://localhost:5173

# Banco Supabase/Postgres
# Use DATABASE_URL para a conexao transacional/pooler.
# Use DIRECT_URL para migrations do Prisma quando o Supabase fornecer uma conexao direta.
DATABASE_URL=postgresql://postgres.PROJECT_REF:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:SENHA@db.PROJECT_REF.supabase.co:5432/postgres

# Empresa padrao usada em rotas operacionais quando o webhook nao recebe companyId.
# Prefira configurar apenas uma das duas; SIGMA_DEFAULT_COMPANY_ID existe como alias.
DEFAULT_COMPANY_ID=
SIGMA_DEFAULT_COMPANY_ID=

# Frontend Vite
VITE_API_URL=http://localhost:3334
VITE_SOCKET_URL=http://localhost:3334

# Provider WhatsApp
# Valores suportados no codigo atual: mock, murilo-api, meta-cloud.
WHATSAPP_PROVIDER=mock

# Provider murilo1of1/whatsapp-api
MURILO_WHATSAPP_API_BASE_URL=http://localhost:3000
MURILO_WHATSAPP_DEFAULT_SESSION_ID=default

# App local apps/whatsapp-api
WHATSAPP_API_PORT=3000
SIGMA_WEBHOOK_URL=http://localhost:3334/api/whatsapp/webhook
SIGMA_WHATSAPP_BASE_URL=http://localhost:3334/api/whatsapp
CHROME_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Token compartilhado para chamadas internas entre apps/whatsapp-api e apps/api.
# Permite que a API local acione sync de histórico sem precisar de JWT de usuário.
# Deve ser igual ao SIGMA_INTERNAL_TOKEN configurado no apps/whatsapp-api/.env.
SIGMA_INTERNAL_TOKEN=troque-por-um-segredo-longo-e-aleatorio

# Provider Meta Cloud API, se WHATSAPP_PROVIDER=meta-cloud.
META_WHATSAPP_API_BASE_URL=https://graph.facebook.com/v20.0
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_VERIFY_TOKEN=
