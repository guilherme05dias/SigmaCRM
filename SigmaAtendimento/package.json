{
  "name": "sigma-atendimento",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=@sigma/api",
    "dev:web": "npm run dev --workspace=@sigma/web",
    "dev": "npx concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "build:api": "npm run build --workspace=@sigma/api",
    "build:web": "npm run build --workspace=@sigma/web",
    "build": "npm run build:api && npm run build:web",
    "typecheck": "tsc --noEmit -p apps/api/tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json && tsc --noEmit -p packages/shared/tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/supertest": "^6.0.3",
    "concurrently": "^8.2.2",
    "jsdom": "^25.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "supertest": "^7.2.2",
    "typescript": "^5.3.0",
    "vitest": "^2.1.9"
  }
}
